# ==============================================================================
# CreatorFlow Environment Configuration Example
# Copy this file to .env and supply your Google Gemini API key
# ==============================================================================

# Required: Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Configurable Gemini Model (Default: gemini-3.8-flash)
# Options: gemini-3.8-flash, gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-3.8-flash

# Optional: Gemini API Request Timeout in milliseconds (Default: 60000 ms = 60s)
GEMINI_REQUEST_TIMEOUT=60000

# Optional: SQLite Database Path (Default: creatorflow.db in project root)
DATABASE_FILE=creatorflow.db
